# Default LLM provider when the user hasn't picked their own: gemini | anthropic | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# TigerData (Timescale Postgres) — caches generated roadmaps. Optional.
DATABASE_URL=

# swarms.ai — not wired yet (see README)
SWARMS_API_KEY=

# BLS public API key (optional, free): raises the limit from 25 to 500 requests/day
BLS_API_KEY=

# Gemini prebuilt voices for the two guides (optional overrides)
SONAR_VOICE=Charon
TIDE_VOICE=Sulafat
